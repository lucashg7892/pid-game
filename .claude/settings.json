{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm.cmd run *)",
      "Bash(npx vitest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": ["Bash(git push*)", "Bash(git reset --hard*)", "Bash(rm -rf *)"]
  }
}
