{
  "name": "pid-game",
  "version": "0.3.0",
  "private": true,
  "description": "Jeu web éducatif sur l'automatique et le contrôleur PID (three.js, WebGPU/WebGL2).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check . && depcruise src --config .dependency-cruiser.cjs",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
